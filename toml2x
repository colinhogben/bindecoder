#!/usr/bin/python3
try:
    import tomllib
except ImportError:
    import tomli as tomllib
import sys

myname, mode = sys.argv

with open('pyproject.toml', 'rb') as f:
    data = tomllib.load(f)
project = data['project']

if mode == 'spec':
    print(f'#--- generated by {myname}')
    print('%define version', project['version'])
    print('%define summary', project['description'])
    print('%define author', project['authors'][0]['name'])
    print('%define author_email', project['authors'][0]['email'])
    print('%define url', project['urls']['Homepage'])
    print(f'#--- end generated by {myname}')
elif mode == 'version':
    print(project['version'])
else:
    raise ValueError(f'Unknown mode "{mode}"')
